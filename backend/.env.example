# Supabase (anon key aman di browser; service_role HANYA di server, jangan pakai prefix NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Domain frontend yang diizinkan CORS (pisahkan koma bila lebih dari satu). Default: https://bantuyuk.vercel.app
FRONTEND_ORIGIN=

# Rahasia bersama untuk webhook pembayaran (header x-webhook-secret). Tanpa ini webhook ditolak (503).
PAYMENT_WEBHOOK_SECRET=

# NASA FIRMS (hanya server)
FIRMS_MAP_KEY=
